AGENT_SHELL_SANDBOX_DENY_PATHS=
AGENT_SHELL_SANDBOX_PASS_ENV=GH_TOKEN
AGENT_SHELL_SANDBOX_ALLOW_NETWORK=true

CHANNEL_TELEGRAM_TOKEN=
CHANNEL_TELEGRAM_USER_ID=
CHANNEL_DISCORD_TOKEN=
CHANNEL_DISCORD_CHANNEL_ID=
