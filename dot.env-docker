INFERENCE_MODEL=qwen/qwen3.5-9b
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=

AGENT_MAX_MESSAGE=1000
AGENT_MAX_COMPLETION_TOKEN=262144

# If you keep the following settings empty, it will be like AI ChatBot instead of AI Assistant.
# Use the system prompt that works best for you or leave it empty.
# Only keep the tools you need. Otherwise, it is just token waste.
# TaskTool is the "SUBAGENT" tool.
AGENT_PATH_MEMORY=/workspace/memory
AGENT_PATHS_AGENTS=/data/agents
AGENT_PATHS_SKILLS=/data/skills
MCP_SERVERS_CONFIGURATION=/data/mcp-servers.json
AGENT_TOOLS=TaskTool,SkillTool,ImageReaderTool,GrepTool,GlobTool,ShellTools,FileSystemTools,ListDirectoryTool,SmartWebFetchTool,TodoWriteTool

CHANNEL_TELEGRAM_TOKEN=
CHANNEL_TELEGRAM_USER_ID=
CHANNEL_DISCORD_TOKEN=
CHANNEL_DISCORD_CHANNEL_ID=
