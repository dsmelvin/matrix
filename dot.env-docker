INFERENCE_BASE_URL=http://host.docker.internal:9931/v1
INFERENCE_API_KEY=

AGENT_PATH_MEMORY=/workspace/memory
AGENT_PATHS_AGENTS=/metadata/agents
AGENT_PATHS_SKILLS=/metadata/skills
MCP_SERVERS_CONFIGURATION=/metadata/mcp-servers.json
MAIN_AGENT_TOOLBOX=Task,Skill

# Shell sandbox (lists are separated by ","; relative paths are resolved against the workspace)
