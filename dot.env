INFERENCE_MODEL=unsloth/Qwen3.5-9B-GGUF:Q4_K_XL
INFERENCE_BASE_URL=http://127.0.0.1:9931/v1
INFERENCE_API_KEY=

AGENT_PATH_MEMORY=workspace/memory
AGENT_PATHS_AGENTS=metadata/agents
AGENT_PATHS_SKILLS=metadata/skills
MCP_SERVERS_CONFIGURATION=metadata/mcp-servers.json
MAIN_AGENT_TOOLBOX=Task,Skill

# Git tool (no sandbox, but only git on local repositories, with its own remote access control)
# fetch/pull/push/ls-remote only work with configured remote names whose host is listed here; empty = no remote access.
# AGENT_GIT_ALLOWED_REMOTE_HOSTS=bitbucket.rks-cloud.com,github.com
# Push is off by default. It is never forced, never deletes, and never targets a protected branch (default: main,master;
# "release/*" style prefixes are supported).
# AGENT_GIT_ALLOW_PUSH=false
# AGENT_GIT_PROTECTED_BRANCHES=main,master,release/*
# The only credentials the tool uses (ssh-agent, keychain and ~/.ssh/config are NOT used). Use a key/token that can only
# access the repositories you want the agent to push to.
# AGENT_GIT_SSH_KEY=~/.ssh/matrix_deploy_key
# AGENT_GIT_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# AGENT_GIT_HTTPS_TOKEN=

CHANNEL_TELEGRAM_TOKEN=
CHANNEL_TELEGRAM_USER_ID=
CHANNEL_DISCORD_TOKEN=
CHANNEL_DISCORD_CHANNEL_ID=

# Shell sandbox (applies to the shell/bash tool only)
# Requires 'sandbox-exec' on macOS (built in) or 'bubblewrap' (bwrap) on Linux.
# Lists are separated by ","; relative paths are resolved against the workspace.
# Mode: what to do when no sandbox is available.
#   required = refuse to run commands (default; inside a docker container the default is off)
#   auto     = run commands without a sandbox, with a warning
#   off      = disable the sandbox
# AGENT_SHELL_SANDBOX_MODE=required
AGENT_SHELL_SANDBOX_WRITABLE_PATHS=~/.m2,~/.npm
AGENT_SHELL_SANDBOX_DENY_PATHS=
AGENT_SHELL_SANDBOX_DENY_FILE_NAMES=.env,.env.*,*.pem,*.key
AGENT_SHELL_SANDBOX_PASS_ENV=GH_TOKEN
# Network: true = unrestricted, false = no network at all.
AGENT_SHELL_SANDBOX_ALLOW_NETWORK=true
# Or only allow specific hosts or URLs ("*.example.com" matches sub domains).
# When set, this takes precedence over ALLOW_NETWORK=true. Only HTTP(S) traffic works, through a local filtering proxy.
# On Linux this also needs 'socat' installed, otherwise the network is blocked.
# AGENT_SHELL_SANDBOX_ALLOWED_HOSTS=github.com,*.githubusercontent.com,https://repo.maven.apache.org
